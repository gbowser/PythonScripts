#   - {_votable_arraysize: '*'}
#   subtype: json
# - name: dist_opt
#   unit: arcsec
#   datatype: float32
#   format: '{:.1f}'
#   description: distance in arcsec relative to associated optical source
#   meta: !!omap
#   - {precision: F1}
