#   unit: mag
#   datatype: float32
#   format: '{:.3f}'
#   description: corrected H band photometric uncertainty
#   meta: !!omap
#   - {precision: F3}
# - name: h_msigcom
#   unit: mag
#   datatype: float32
#   format: '{:.3f}'
#   description: combined (total) H band photometric uncertainty
#   meta: !!omap
#   - {precision: F3}
# - name: h_snr
#   datatype: float64
#   format: '{:.1f}'
#   description: H band "scan" signal-to-noise ratio
#   meta: !!omap
#   - {precision: F1}
# - name: k_m
#   unit: mag
#   datatype: float32
#   format: '{:.3f}'
#   description: K band selected "default" magnitude
#   meta: !!omap
#   - {ucd: phot.mag;em.IR.K}
#   - {precision: F3}
# - name: k_cmsig
#   unit: mag
#   datatype: float32
#   format: '{:.3f}'
#   description: corrected K band photometric uncertainty
#   meta: !!omap
#   - {precision: F3}
# - name: k_msigcom
#   unit: mag
#   datatype: float32
#   format: '{:.3f}'
#   description: combined (total) K band photometric uncertainty
#   meta: !!omap
#   - {precision: F3}
# - name: k_snr
#   datatype: float64
#   format: '{:.1f}'
#   description: K band "scan" signal-to-noise ratio
#   meta: !!omap
#   - {precision: F1}
# - name: ph_qual
#   datatype: string
#   description: flag indicating photometric quality of source
#   meta: !!omap
#   - {ucd: meta.code.qual}
#   - {_votable_string_dtype: char}
#   - {_votable_arraysize: '*'}
#   subtype: json
# - name: rd_flg
#   datatype: string
#   description: source of JHK "default" mags (AKA "read flag")
#   meta: !!omap
#   - {_votable_string_dtype: char}
#   - {_votable_arraysize: '*'}
#   subtype: json
# - name: bl_flg
#   datatype: string
#   description: 'indicates # JHK components fit simultaneously to source'
