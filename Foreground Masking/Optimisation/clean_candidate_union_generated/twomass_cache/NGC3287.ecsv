#   unit: mag
#   datatype: float32
#   format: '{:.3f}'
#   description: combined (total) J band photometric uncertainty
#   meta: !!omap
#   - {precision: F3}
# - name: j_snr
#   datatype: float64
#   format: '{:.1f}'
#   description: J band "scan" signal-to-noise ratio
#   meta: !!omap
#   - {precision: F1}
