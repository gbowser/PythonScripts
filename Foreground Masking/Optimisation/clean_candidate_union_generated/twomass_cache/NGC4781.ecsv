# %ECSV 1.0
# ---
# datatype:
# - name: ra
#   unit: deg
#   datatype: float64
#   format: '{:.6f}'
#   description: right ascension (J2000 decimal deg)
#   meta: !!omap
#   - {ucd: pos.eq.ra;meta.main}
#   - {precision: F6}
# - name: dec
#   unit: deg
#   datatype: float64
#   format: '{:.6f}'
#   description: declination (J2000 decimal deg)
#   meta: !!omap
#   - {ucd: pos.eq.dec;meta.main}
#   - {precision: F6}
# - name: err_maj
#   unit: arcsec
#   datatype: float32
#   format: '{:.2f}'
#   description: Semi-major axis length of the one sigma position uncertainty ellipse
#   meta: !!omap
#   - {precision: F2}
# - name: err_min
#   unit: arcsec
#   datatype: float32
#   format: '{:.2f}'
#   description: Semi-minor axis length of the one sigma position uncertainty ellipse
#   meta: !!omap
#   - {precision: F2}
# - {name: err_ang, unit: deg, datatype: int32, description: angle of error ellipse major axis (E of N)}
# - name: designation
#   datatype: string
#   description: source designation formed from sexigesimal coordinates
#   meta: !!omap
#   - {ucd: meta.id;meta.main}
#   - {_votable_string_dtype: char}
#   - {_votable_arraysize: '*'}
#   subtype: json
