#   unit: d
#   datatype: float64
#   format: '{:.4f}'
#   description: julian date of source measurement to +/- 30 sec
#   meta: !!omap
#   - {precision: F4}
# - name: j_psfchi
#   datatype: float32
#   format: '{:.2f}'
#   description: J band reduced chi-squared goodness-of-fit value
#   meta: !!omap
#   - {precision: F2}
# - name: h_psfchi
#   datatype: float32
