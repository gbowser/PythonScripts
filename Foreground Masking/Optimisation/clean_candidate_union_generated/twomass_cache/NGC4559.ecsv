#   - {precision: F1}
# - name: ph_qual
#   datatype: string
#   description: flag indicating photometric quality of source
#   meta: !!omap
#   - {ucd: meta.code.qual}
#   - {_votable_string_dtype: char}
#   - {_votable_arraysize: '*'}
#   subtype: json
# - name: rd_flg
#   datatype: string
#   description: source of JHK "default" mags (AKA "read flag")
#   meta: !!omap
#   - {_votable_string_dtype: char}
#   - {_votable_arraysize: '*'}
#   subtype: json
