#   - {_votable_arraysize: '*'}
#   subtype: json
# - name: ndet
#   datatype: string
#   description: 'number of >3-sig. ap. mag measurements, # possible (jjhhkk)'
#   meta: !!omap
#   - {_votable_string_dtype: char}
#   - {_votable_arraysize: '*'}
#   subtype: json
# - name: prox
#   unit: arcsec
#   datatype: float32
#   format: '{:.1f}'
#   description: distance in arcsec to nearest catalog point source
#   meta: !!omap
#   - {precision: F1}
# - {name: pxpa, unit: deg, datatype: int32, description: angle (deg E of N) to nearest catalog point source}
# - {name: pxcntr, datatype: int64, description: cntr of nearest catalog point source}
# - {name: gal_contam, datatype: int32, description: flag indicating if src is contaminated by extended source}
# - {name: mp_flg, datatype: int32, description: 'src is positionally associated with an asteroid, comet, etc'}
# - name: cntr
#   datatype: int64
#   description: entry key (counter) number (unique within table)
#   meta: !!omap
#   - {ucd: meta.record;meta.main}
# - name: hemis
#   datatype: string
#   description: hemisphere (N/S) of facility from which src was observed
#   meta: !!omap
#   - {_votable_string_dtype: char}
#   - {_votable_arraysize: '*'}
#   subtype: json
# - name: xdate
#   datatype: string
#   description: observation reference date
#   meta: !!omap
#   - {_votable_string_dtype: char}
#   - {_votable_arraysize: '*'}
#   subtype: json
# - {name: scan, datatype: int32, description: scan number (unique within date)}
# - name: glon
#   unit: deg
#   datatype: float64
#   format: '{:.3f}'
#   description: galactic longitude (decimal deg)
#   meta: !!omap
#   - {precision: F3}
# - name: glat
#   unit: deg
#   datatype: float64
#   format: '{:.3f}'
#   description: galactic latitude (decimal deg)
#   meta: !!omap
#   - {precision: F3}
# - name: x
#   datatype: float64
#   format: '{:.16f}'
#   description: unit sphere x value
#   meta: !!omap
#   - {ucd: pos.cartesian.x}
#   - {precision: F16}
# - name: y
#   datatype: float64
#   format: '{:.16f}'
#   description: unit sphere y value
#   meta: !!omap
#   - {ucd: pos.cartesian.y}
#   - {precision: F16}
# - name: z
#   datatype: float64
#   format: '{:.16f}'
#   description: unit sphere z value
#   meta: !!omap
#   - {ucd: pos.cartesian.z}
#   - {precision: F16}
# - name: x_scan
#   unit: arcsec
#   datatype: float32
#   format: '{:.1f}'
#   description: x (cross-scan) position (U-Scan coord.)
#   meta: !!omap
#   - {precision: F1}
# - name: jdate
#   unit: d
#   datatype: float64
#   format: '{:.4f}'
#   description: julian date of source measurement to +/- 30 sec
#   meta: !!omap
#   - {precision: F4}
# - name: j_psfchi
#   datatype: float32
#   format: '{:.2f}'
#   description: J band reduced chi-squared goodness-of-fit value
#   meta: !!omap
#   - {precision: F2}
# - name: h_psfchi
#   datatype: float32
#   format: '{:.2f}'
#   description: H band reduced chi-squared goodness-of-fit value
#   meta: !!omap
#   - {precision: F2}
# - name: k_psfchi
#   datatype: float32
#   format: '{:.2f}'
#   description: K band reduced chi-squared goodness-of-fit value
#   meta: !!omap
#   - {precision: F2}
# - name: j_m_stdap
#   unit: mag
#   datatype: float32
#   format: '{:.3f}'
#   description: J band standard (r=4") aperture magnitude
#   meta: !!omap
#   - {precision: F3}
# - name: j_msig_stdap
#   unit: mag
#   datatype: float32
#   format: '{:.3f}'
#   description: J band standard (r=4") aperture mag uncertainty
#   meta: !!omap
#   - {precision: F3}
# - name: h_m_stdap
#   unit: mag
#   datatype: float32
#   format: '{:.3f}'
#   description: H band standard (r=4") aperture magnitude
#   meta: !!omap
#   - {precision: F3}
# - name: h_msig_stdap
#   unit: mag
#   datatype: float32
#   format: '{:.3f}'
#   description: H band standard (r=4") aperture mag uncertainty
#   meta: !!omap
#   - {precision: F3}
# - name: k_m_stdap
#   unit: mag
#   datatype: float32
#   format: '{:.3f}'
#   description: K band standard (r=4") aperture magnitude
#   meta: !!omap
#   - {precision: F3}
# - name: k_msig_stdap
#   unit: mag
#   datatype: float32
#   format: '{:.3f}'
#   description: K band standard (r=4") aperture mag uncertainty
#   meta: !!omap
#   - {precision: F3}
# - {name: dist_edge_ns, unit: arcsec, datatype: float32, description: distance to nearest north or south full-coverage scan edge}
# - {name: dist_edge_ew, unit: arcsec, datatype: float32, description: distance to nearest east or west full-coverage scan edge}
# - name: dist_edge_flg
#   datatype: string
#   description: flag indicating which edges ([n|s][e|w]) are nearest to src
#   meta: !!omap
#   - {_votable_string_dtype: char}
#   - {_votable_arraysize: '*'}
#   subtype: json
# - {name: dup_src, datatype: int32, description: duplicate source extractions flag (overlap areas)}
# - {name: use_src, datatype: int32, description: use source flag -- source is to be used in catalog}
# - name: a
#   datatype: string
#   description: optical source catalog identifier of closest match within 5"
#   meta: !!omap
#   - {_votable_string_dtype: char}
#   - {_votable_arraysize: '*'}
#   subtype: json
# - name: dist_opt
#   unit: arcsec
#   datatype: float32
#   format: '{:.1f}'
#   description: distance in arcsec relative to associated optical source
#   meta: !!omap
#   - {precision: F1}
# - {name: phi_opt, unit: deg, datatype: int32, description: position angle relative to optical source (E of N)}
# - name: b_m_opt
#   unit: mag
#   datatype: float32
#   format: '{:.2f}'
#   description: catalog blue mag of associated optical source
#   meta: !!omap
#   - {precision: F2}
# - name: vr_m_opt
#   unit: mag
#   datatype: float32
#   format: '{:.2f}'
#   description: catalog visual or red mag of associated optical source
#   meta: !!omap
#   - {precision: F2}
# - {name: nopt_mchs, datatype: int32, description: number of optical sources matched to this 2MASS source}
# - {name: ext_key, datatype: int64, description: key to extended source data DB record}
# - {name: scan_key, datatype: int64, description: key to scan data record in the scan information table}
# - {name: coadd_key, datatype: int64, description: key to coadd data record in the atlas image data table}
# - {name: coadd, datatype: int32, description: number of atlas image in which the source falls}
# - name: htm20
#   datatype: int64
#   description: HTM 20 spatial (x,y,z) index key
#   meta: !!omap
#   - {ucd: pos.HTM}
