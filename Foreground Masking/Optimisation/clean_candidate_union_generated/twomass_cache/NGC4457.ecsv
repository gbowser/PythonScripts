# datatype:
# - name: ra
#   unit: deg
#   datatype: float64
#   format: '{:.6f}'
#   description: right ascension (J2000 decimal deg)
#   meta: !!omap
#   - {ucd: pos.eq.ra;meta.main}
#   - {precision: F6}
