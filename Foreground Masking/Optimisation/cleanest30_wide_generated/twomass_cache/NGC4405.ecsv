#   unit: arcsec
#   datatype: float32
#   format: '{:.2f}'
#   description: Semi-minor axis length of the one sigma position uncertainty ellipse
#   meta: !!omap
#   - {precision: F2}
# - {name: err_ang, unit: deg, datatype: int32, description: angle of error ellipse major axis (E of N)}
