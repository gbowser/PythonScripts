#   datatype: float64
#   format: '{:.16f}'
#   description: unit sphere x value
#   meta: !!omap
#   - {ucd: pos.cartesian.x}
#   - {precision: F16}
# - name: y
#   datatype: float64
#   format: '{:.16f}'
#   description: unit sphere y value
#   meta: !!omap
#   - {ucd: pos.cartesian.y}
#   - {precision: F16}
# - name: z
#   datatype: float64
#   format: '{:.16f}'
#   description: unit sphere z value
#   meta: !!omap
#   - {ucd: pos.cartesian.z}
#   - {precision: F16}
# - name: x_scan
#   unit: arcsec
#   datatype: float32
#   format: '{:.1f}'
#   description: x (cross-scan) position (U-Scan coord.)
#   meta: !!omap
#   - {precision: F1}
