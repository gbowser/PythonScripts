# %ECSV 1.0
# ---
# datatype:
# - name: ra
#   unit: deg
#   datatype: float64
#   format: '{:.6f}'
#   description: right ascension (J2000 decimal deg)
#   meta: !!omap
#   - {ucd: pos.eq.ra;meta.main}
#   - {precision: F6}
# - name: dec
#   unit: deg
#   datatype: float64
#   format: '{:.6f}'
#   description: declination (J2000 decimal deg)
#   meta: !!omap
#   - {ucd: pos.eq.dec;meta.main}
#   - {precision: F6}
# - name: err_maj
#   unit: arcsec
#   datatype: float32
#   format: '{:.2f}'
#   description: Semi-major axis length of the one sigma position uncertainty ellipse
#   meta: !!omap
#   - {precision: F2}
# - name: err_min
#   unit: arcsec
#   datatype: float32
#   format: '{:.2f}'
#   description: Semi-minor axis length of the one sigma position uncertainty ellipse
#   meta: !!omap
#   - {precision: F2}
# - {name: err_ang, unit: deg, datatype: int32, description: angle of error ellipse major axis (E of N)}
# - name: designation
#   datatype: string
#   description: source designation formed from sexigesimal coordinates
#   meta: !!omap
#   - {ucd: meta.id;meta.main}
#   - {_votable_string_dtype: char}
#   - {_votable_arraysize: '*'}
#   subtype: json
# - name: j_m
#   unit: mag
#   datatype: float32
#   format: '{:.3f}'
#   description: J band selected "default" magnitude
#   meta: !!omap
#   - {ucd: phot.mag;em.IR.J}
#   - {precision: F3}
# - name: j_cmsig
#   unit: mag
#   datatype: float32
#   format: '{:.3f}'
#   description: corrected J band photometric uncertainty
#   meta: !!omap
#   - {precision: F3}
# - name: j_msigcom
#   unit: mag
#   datatype: float32
#   format: '{:.3f}'
#   description: combined (total) J band photometric uncertainty
#   meta: !!omap
#   - {precision: F3}
# - name: j_snr
#   datatype: float64
#   format: '{:.1f}'
#   description: J band "scan" signal-to-noise ratio
#   meta: !!omap
#   - {precision: F1}
