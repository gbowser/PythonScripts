# - name: a
#   datatype: string
#   description: optical source catalog identifier of closest match within 5"
#   meta: !!omap
#   - {_votable_string_dtype: char}
#   - {_votable_arraysize: '*'}
#   subtype: json
# - name: dist_opt
#   unit: arcsec
#   datatype: float32
#   format: '{:.1f}'
#   description: distance in arcsec relative to associated optical source
#   meta: !!omap
#   - {precision: F1}
# - {name: phi_opt, unit: deg, datatype: int32, description: position angle relative to optical source (E of N)}
# - name: b_m_opt
#   unit: mag
#   datatype: float32
#   format: '{:.2f}'
#   description: catalog blue mag of associated optical source
#   meta: !!omap
#   - {precision: F2}
# - name: vr_m_opt
#   unit: mag
#   datatype: float32
#   format: '{:.2f}'
#   description: catalog visual or red mag of associated optical source
#   meta: !!omap
#   - {precision: F2}
# - {name: nopt_mchs, datatype: int32, description: number of optical sources matched to this 2MASS source}
# - {name: ext_key, datatype: int64, description: key to extended source data DB record}
# - {name: scan_key, datatype: int64, description: key to scan data record in the scan information table}
# - {name: coadd_key, datatype: int64, description: key to coadd data record in the atlas image data table}
# - {name: coadd, datatype: int32, description: number of atlas image in which the source falls}
# - name: htm20
#   datatype: int64
#   description: HTM 20 spatial (x,y,z) index key
#   meta: !!omap
#   - {ucd: pos.HTM}
